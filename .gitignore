# API keys — never commit these
config.json

# Raw API responses kept by the harvesters (data/raw/<provider>/...)
data/raw/

# Timestamped database copies from `tools.py backup`
data/backups/

# Your database: created and seeded on first launch, never versioned.
# Back it up with `python3 app/tools.py backup`.
data/*.db
data/*.db-wal
data/*.db-shm

# Scratch output from the Prospeo notebook (contains real people's data)
prospeo_*.json

# The superseded scratch notebook (app/providers/prospeo.py is the real code).
# Kept on disk, but it must never be committed again.
Prospeo_API.ipynb

# Scratch notebooks. They are throwaway experiments, they hold real people's
# data, and `email_sending.ipynb` had a live Gmail app password pasted into a
# cell - a credential in version control, which is the one thing this file exists
# to prevent. Kept on disk, never committed again.
*.ipynb

# Browser profile left by a scraping experiment
chrome_profile/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Agent tooling state (local session notes and worktrees - not project code)
.workbuddy-ai/
.kilo/

# Logs
*.log